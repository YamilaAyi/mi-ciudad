42},{"ruleId":"273","severity":1,"message":"292","line":6,"column":10,"nodeType":"275","messageId":"276","endLine":6,"endColumn":20,"suggestions":"293"},{"ruleId":"280","severity":1,"message":"281","line":6,"column":28,"nodeType":"282","endLine":6,"endColumn":42},{"ruleId":"280","severity":1,"message":"294","line":1,"column":26,"nodeType":"282","endLine":1,"endColumn":33,"fix":"295"},{"ruleId":"280","severity":1,"message":"294","line":4,"column":27,"nodeType":"282","endLine":4,"endColumn":34},{"ruleId":"296","severity":2,"message":"297","line":52,"column":5,"nodeType":null,"endLine":52,"endColumn":11},{"ruleId":"296","severity":2,"message":"298","line":15,"column":5,"nodeType":null,"endLine":15,"endColumn":13},{"ruleId":"296","severity":2,"message":"299","line":11,"column":5,"nodeType":null,"endLine":11,"endColumn":19},{"ruleId":"273","severity":1,"message":"300","line":1,"column":10,"nodeType":"275","messageId":"276","endLine":1,"endColumn":21,"suggestions":"301"},"@typescript-eslint/no-unused-vars","'TextInput' is defined but never used.","Identifier","unusedVar",["302"],"'Image' is defined but never used.",["303"],"import/no-duplicates","'C:\\Users\\pplea\\OneDrive\\Documentos\\mi-ciudad\\node_modules\\react-native\\index.js' imported multiple times.","Literal",{"range":"304","text":"305"},"'SafeAreaView' is defined but never used.",["306"],"'BottomTabInset' is defined but never used.",["307"],"'MaxContentWidth' is defined but never used.",["308"],"'Spacing' is defined but never used.",["309"],"'ScrollView' is defined but never used.",["310"],"'C:\\Users\\pplea\\OneDrive\\Documentos\\mi-ciudad\\node_modules\\react\\index.js' imported multiple times.",{"range":"311","text":"312"},"react-hooks/set-state-in-effect","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Users\\pplea\\OneDrive\\Documentos\\mi-ciudad\\src\\app\\visita\\[id].tsx:52:5\n  50 |\n  51 |   useEffect(() => {\n> 52 |     cargar();\n     |     ^^^^^^ Avoid calling setState() directly within an effect\n  53 |   }, [cargar]);\n  54 |\n  55 |   if (cargando) {","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Users\\pplea\\OneDrive\\Documentos\\mi-ciudad\\src\\components\\FotoVisita.tsx:15:5\n  13 |   // Si cambia la foto, volvemos a intentar cargarla.\n  14 |   useEffect(() => {\n> 15 |     setFallo(false);\n     |     ^^^^^^^^ Avoid calling setState() directly within an effect\n  16 |   }, [uri]);\n  17 |\n  18 |   if (!uri || fallo) {","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Users\\pplea\\OneDrive\\Documentos\\mi-ciudad\\src\\hooks\\use-color-scheme.web.ts:11:5\n   9 |\n  10 |   useEffect(() => {\n> 11 |     setHasHydrated(true);\n     |     ^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  12 |   }, []);\n  13 |\n  14 |   const colorScheme = useRNColorScheme();","'borrarCache' is defined but never used.",["313"],{"messageId":"314","data":"315","fix":"316","desc":"317"},{"messageId":"314","data":"318","fix":"319","desc":"320"},[107,360],", View, Text , ScrollView } from 'react-native';\r\nimport { SafeAreaView } from 'react-native-safe-area-context';\r\nimport { BottomTabInset, MaxContentWidth, Spacing } from '@/constants/theme';\r\n\r\n",{"messageId":"321","data":"322","fix":"323","desc":"324"},{"messageId":"314","data":"325","fix":"326","desc":"327"},{"messageId":"314","data":"328","fix":"329","desc":"330"},{"messageId":"321","data":"331","fix":"332","desc":"324"},{"messageId":"321","data":"333","fix":"334","desc":"324"},[18,216],", useEffect } from 'react';\r\nimport { Text, StyleSheet, ScrollView, TextInput , View , Pressable} from 'react-native';\r\nimport TarjetaLugar from '../components/TarjetaLugar';\r\n",{"messageId":"314","data":"335","fix":"336","desc":"337"},"removeUnusedVar",{"varName":"338"},{"range":"339","text":"340"},"Remove unused variable \"TextInput\".",{"varName":"341"},{"range":"342","text":"340"},"Remove unused variable \"Image\".","removeUnusedImportDeclaration",{"varName":"343"},{"range":"344","text":"340"},"Remove unused import declaration.",