{
  "expo": {
    "name": "mi-ciudad",
    "slug": "mi-ciudad",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "miciudad",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.colon.miciudad.grupo70"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-vector-icons/ionicons",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir que Mi Ciudad use Face ID para iniciar sesión."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Mi Ciudad usa la cámara para leer el código QR de los carteles.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mi Ciudad usa tu ubicación para confirmar que estás en el lugar que visitás y mostrarte lo que tenés cerca."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Mi Ciudad necesita la cámara para que puedas sacar una foto de tu visita.",
          "photosPermission": "Mi Ciudad necesita acceder a tus fotos para que puedas elegir una para tu visita."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ad094128-6690-4ae0-ad89-0aee9c965795"
      }
    },
    "owner": "maryolivares"
  }
}
